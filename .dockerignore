# Всё, что не нужно в контексте сборки.
#
# .dockerignore влияет на две вещи: скорость (контекст целиком уезжает
# демону перед сборкой) и безопасность (без него .git и локальные .env
# попадают в образ через COPY . . — это реальный способ утечки секретов
# в публичный registry).
.git
.gitignore
.github
.env
.env.*
*.md
Dockerfile
.dockerignore
deploy/
compose.yaml
/scheduler
