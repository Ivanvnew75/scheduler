# Многостадийная сборка.
#
# Стадия 1 (builder) содержит компилятор Go, исходники, кэш модулей — ~900 МБ.
# Стадия 2 содержит один статический бинарник. В финальный образ попадает
# только вторая стадия, всё остальное отбрасывается.
#
# Зачем это в терминах 12 Factor: Фактор 5 (Build, release, run) требует
# строгого разделения стадий. Образ — это артефакт стадии build; в нём не
# должно быть ничего, что нужно только для сборки. Плюс прикладной эффект:
# меньше пакетов в рантайме — меньше CVE и меньше того, чем может
# воспользоваться атакующий, пробравшийся в контейнер.

# ---------- build ----------
FROM golang:1.26-alpine AS builder

WORKDIR /src

# Сначала копируем ТОЛЬКО go.mod/go.sum и качаем зависимости.
# Это не стилистика, а работа с кэшем слоёв Docker: слой инвалидируется,
# когда меняются его входные файлы. Правка main.go не должна приводить
# к повторному скачиванию всех модулей — а если копировать весь исходник
# одной командой COPY . ., то будет именно так.
COPY go.mod go.sum ./
RUN go mod download

COPY . .

# CGO_ENABLED=0 — статическая линковка: бинарник не зависит от libc
# и запустится в scratch/distroless. Без этого Go тянет системный
# резолвер через cgo, и бинарник, собранный на glibc-образе, падает
# на alpine (musl) с «no such file or directory» — сообщение,
# которое совершенно не наводит на мысль о линковке.
#
# -trimpath убирает абсолютные пути сборочной машины из бинарника
# (иначе там окажется /home/ivan/... — утечка и помеха
# воспроизводимости сборки).
#
# -ldflags "-s -w" выбрасывает таблицу символов и DWARF: минус ~25% размера.
# Цена — стек-трейсы без номеров строк в дебаггере; для прод-сервиса,
# который отлаживают по логам и метрикам, обмен выгодный.
ARG VERSION=dev
ARG COMMIT=unknown
RUN CGO_ENABLED=0 GOOS=linux go build \
      -trimpath \
      -ldflags="-s -w -X main.version=${VERSION} -X main.commit=${COMMIT}" \
      -o /out/scheduler .

# ---------- runtime ----------
FROM alpine:3.22

# ca-certificates нужны для исходящих HTTPS-запросов (в этом сервисе пока нет,
# но появятся в telegram-api — держим базовый образ одинаковым).
# tzdata — чтобы TZ/расписания считались в нужной зоне, а не всегда в UTC.
RUN apk add --no-cache ca-certificates tzdata

# Непривилегированный пользователь.
#
# По умолчанию контейнер работает от root, и это самый частый замечаемый
# на аудите недочёт: побег из контейнера или запись в примонтированный том
# происходят с правами root на хосте. UID задан числом (10001), а не только
# именем: securityContext.runAsNonRoot в Kubernetes умеет проверить
# «не root» лишь по числовому UID, имя пользователя ему ничего не говорит.
RUN adduser -D -u 10001 app
USER 10001:10001

COPY --from=builder /out/scheduler /usr/local/bin/scheduler

# EXPOSE — документация, а не настройка: он ничего не открывает и не
# пробрасывает. Реальный порт задаётся переменной SERVER_PORT (Фактор 3)
# и публикуется уже средой запуска (Docker -p / k8s containerPort).
EXPOSE 8080

# Форма exec (JSON-массив), а не shell.
# В shell-форме процессом с PID 1 становится /bin/sh, и SIGTERM от Kubernetes
# приходит ему, а не приложению — graceful shutdown (Фактор 9) не срабатывает,
# под каждый раз убивается по SIGKILL через grace period.
ENTRYPOINT ["/usr/local/bin/scheduler"]
